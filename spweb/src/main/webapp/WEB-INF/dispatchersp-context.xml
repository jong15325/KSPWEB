		class="view.ContestDownLoad"> <property name="dao" ref="chanwonDao" /> </bean> 
		<bean id="MatchingDownload" class="view.MatchingDownLoadView"> <property 
		name="dao" ref="seungyeobDao" /> </bean> -->

	<!-- [10] View 빈 선언 -->

	<!-- view -->
	<!-- <bean class="org.springframework.web.servlet.view.UrlBasedViewResolver"> 
		<property name="viewClass" value="org.springframework.web.servlet.view.tiles2.TilesView" 
		/> <property name="order" value="2" /> </bean> -->


	<bean id="jsonView"
		class="org.springframework.web.servlet.view.json.MappingJackson2JsonView" />

	<bean
		class="org.springframework.web.servlet.view.BeanNameViewResolver">
		<property name="order" value="0" />
	</bean>

	<bean
		class="org.springframework.web.servlet.view.InternalResourceViewResolver">
		<property name="prefix" value="/WEB-INF/view/" />
		<property name="suffix" value=".jsp" />
		<property name="order" value="1" />
	</bean>

	<bean
		class="org.springframework.web.servlet.view.BeanNameViewResolver">
		<property name="order" value="2" />
	</bean>

	<!-- [11] 로그인 인터셉터 -->
	<bean id="authenticationInterceptor"
		class="interceptor.LoginInterceptor"></bean>
	<mvc:interceptors>
		<mvc:interceptor>
			<mvc:mapping path="/*.do" />
			<mvc:exclude-mapping path="/userLogin2.do" />
			<mvc:exclude-mapping path="/userLogin.do" />
			<mvc:exclude-mapping path="/userRegister.do" />
			<mvc:exclude-mapping path="/userRegisterProcess.do" />
			<mvc:exclude-mapping path="/error500.do" />
			<mvc:exclude-mapping path="/error404.do" />
			<mvc:exclude-mapping path="/error.do" />
			<mvc:exclude-mapping path="/index.do" />
			<mvc:exclude-mapping path="/userLoginProcess.do" />
			<mvc:exclude-mapping path="/userLogout.do" />
			<mvc:exclude-mapping path="/oauth.do" />
			<mvc:exclude-mapping path="/userRegisterSuccess.do" />
			<mvc:exclude-mapping path="/userRegisterFail.do" />
			<mvc:exclude-mapping path="/userRegisterNameCheck.do" />
			<mvc:exclude-mapping path="/alReadyConnected.do" />
			<ref bean="authenticationInterceptor" />
		</mvc:interceptor>
	</mvc:interceptors>


