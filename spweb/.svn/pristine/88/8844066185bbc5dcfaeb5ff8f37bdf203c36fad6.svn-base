<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<!DOCTYPE html>
<html>
<%@ include file="../template/head.jsp"%>
<style>
</style>
<body>
	<div class="wrapper">
	<%@ include file="../template/left_column.jsp"%>
	 <div id="page-wrapper" class="white-bg dashbard-1">
	 	<%@ include file="../template/header.jsp"%>
			<div id="carouselmainBanner" class="carousel slide" data-ride="carousel">
				<ol class="carousel-indicators">
                  	<li data-target="#carouselmainBanner" data-slide-to="0" class="active"></li>
                  	<li data-target="#carouselmainBanner" data-slide-to="1" class=""></li>
              		<li data-target="#carouselmainBanner" data-slide-to="2" class=""></li>
              		<li data-target="#carouselmainBanner" data-slide-to="3" class=""></li>
               	</ol>
  				<div class="carousel-inner" style="max-height:400px">
              		<div class="carousel-item active">
             			<img class="d-block w-100" style="max-height:400px" src="img/event_banner/1.jpg" alt="First slide">
              		</div>
           			<div class="carousel-item">
              			<img class="d-block w-100" style="max-height:400px" src="img/event_banner/2.jpg" alt="Second slide">
                	</div>
           			<div class="carousel-item">
                   		<img class="d-block w-100" style="max-height:400px" src="img/event_banner/3.jpg" alt="Third slide">
                 	</div>
                 	<!-- <div class="carousel-item">
                   		<img class="d-block w-100" style="max-height:400px" src="img/event_banner/7.jpg" alt="four slide">
                 	</div> -->
              	</div>
             	<a class="carousel-control-prev" href="#carouselmainBanner" role="button" data-slide="prev">
               		<span class="carousel-control-prev-icon" aria-hidden="true"></span>
                	<span class="sr-only">Previous</span>
                 </a>
                 <a class="carousel-control-next" href="#carouselmainBanner" role="button" data-slide="next">
         			<span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
             	</a>
         	</div>
	 	<div class="row white-bg dashboard-header">
	 		<div class="col-md-6" style="padding-bottom: 20px;">
  				<Strong><i class="fa fa-trophy"></i>   유저</Strong>
				<ul class="list-group clear-list m-t">
            		<li class="list-group-item">
          				<span class="float-right">
            				<strong>레벨</strong>
      					</span>
             			<span style="padding-right: 6px;">
             				<strong>순위</strong>
             			</span>
             			<span>
              				<strong>이름</strong>
              			</span>
           			</li>
            		<c:forEach items="${userRank}" var="UserRankDTO" varStatus="status">
            		<%-- <fmt:formatNumber value="${UserRankDTO.usr_points}" pattern="#,###" var="usr_points_patturn"/> --%>
            			<c:choose>
            				<c:when test="${status.count == 1}">
            					<li class="list-group-item">
          							<span class="float-right">
            							<img alt="image" src="${UserRankDTO.level_img_path}" style="width:12px"/>
      								</span>
              						<span class="label label-danger">${status.count}</span>
              						<Strong>${UserRankDTO.usr_name}</Strong>
           						</li>
            				</c:when>
            				<c:when test="${status.count == 2}">
            					<li class="list-group-item">
          							<span class="float-right">
            							<img alt="image" src="${UserRankDTO.level_img_path}" style="width:12px"/>
      								</span>
              						<span class="label label-warning">${status.count}</span>
              						${UserRankDTO.usr_name}
              					</li>
            				</c:when>
            				<c:when test="${status.count == 3}">
            					<li class="list-group-item">
          							<span class="float-right">
            							<img alt="image" src="${UserRankDTO.level_img_path}" style="width:12px"/>
      								</span>
              						<span class="label label-info">${status.count}</span>
              						${UserRankDTO.usr_name}
              					</li>
            				</c:when>
            				<c:when test="${status.count == 4}">
            					<li class="list-group-item">
          							<span class="float-right">
            							<img alt="image" src="${UserRankDTO.level_img_path}" style="width:12px"/>
      								</span>
              						<span class="label label-success">${status.count}</span>
              						${UserRankDTO.usr_name}
              					</li>
            				</c:when>
            				<c:otherwise>
            					<li class="list-group-item">
          							<span class="float-right">
            							<img alt="image" src="${UserRankDTO.level_img_path}" style="width:12px"/>
      								</span>
              						<span class="label label-primary">${status.count}</span>
              						${UserRankDTO.usr_name}
              					</li>
            				</c:otherwise>
            			</c:choose>
        			</c:forEach>
                  </ul>
             </div>
             <div class="col-md-6">
             	<Strong><i class="fa fa-trophy"></i>   길드</Strong>
  				<small> [점령전 진행중] </small>
            	<ul class="list-group clear-list m-t">
            		<li class="list-group-item">
          				<span class="float-right">
            				<strong>종합 포인트</strong>
      					</span>
             			<span style="padding-right: 6px;">
             				<strong>순위</strong>
             			</span>
             			<span>
              				<strong>이름</strong>
              			</span>
           			</li>
            		<c:forEach items="${guildRank}" var="GuildRankDTO" varStatus="status">
            		<fmt:formatNumber value="${GuildRankDTO.point}" pattern="#,###" var="guild_points_patturn"/>
            			<c:choose>
            				<c:when test="${status.count == 1}">
            					<li class="list-group-item">
          							<span class="float-right">
            							${guild_points_patturn}
      								</span>
              						<span class="label label-danger">${status.count}</span>
              						<Strong>${GuildRankDTO.guild_name}</Strong>
           						</li>
            				</c:when>
            				<c:when test="${status.count == 2}">
            					<li class="list-group-item">
          							<span class="float-right">
            							${guild_points_patturn}
      								</span>
              						<span class="label label-warning">${status.count}</span>
              						${GuildRankDTO.guild_name}
              					</li>
            				</c:when>
            				<c:when test="${status.count == 3}">
            					<li class="list-group-item">
          							<span class="float-right">
            							${guild_points_patturn}
      								</span>
              						<span class="label label-info">${status.count}</span>
              						${GuildRankDTO.guild_name}
              					</li>
            				</c:when>
            				<c:when test="${status.count == 4}">
            					<li class="list-group-item">
          							<span class="float-right">
            							${guild_points_patturn}
      								</span>
              						<span class="label label-success">${status.count}</span>
              						${GuildRankDTO.guild_name}
              					</li>
            				</c:when>
            				<c:otherwise>
            					<li class="list-group-item">
          							<span class="float-right">
            							${guild_points_patturn}
      								</span>
              						<span class="label label-primary">${status.count}</span>
              						${GuildRankDTO.guild_name}
              					</li>
            				</c:otherwise>
            			</c:choose>
        			</c:forEach>
        		</ul>
			</div>
	 	</div>
	 	<div class="wrapper wrapper-content">
			<div class="row">
	 			<div class="col-lg-12">
	 				<div class="ibox">
	 					<div class="ibox-title">
	 						<h5>공지사항</h5>
	 					  	<c:if test="${sessionScope.userInfoSession != null}">
	 							<button class="btn btn-default btn-xs" id="noticeGo">바로가기</button>
	 					  	</c:if>
	 					</div>
	 					<c:forEach items="${notice}" var="NoticeDTO">
	 						<div class="ibox-content">
	 							${NoticeDTO.article_title}
	 						</div>
	 					</c:forEach>
	 				</div>
	 			</div>
	 		</div>
		<div class="row">
	 		<div class="col-lg-12">
	 			<div class="ibox">
	 				<div class="ibox-title">
	 					<h5>이벤트</h5>
	 					<c:if test="${sessionScope.userInfoSession != null}">
	 						<button class="btn btn-default btn-xs" id="eventGo">바로가기</button>
	 					</c:if>
	 				</div>
	 				<c:forEach items="${event}" var="EventDTO">
	 					<div class="ibox-content">
	 						${EventDTO.article_title}
	 					</div>
	 				</c:forEach>
	 			</div>
	 		</div>
	 	</div>
	 	<div class="row">
	 		<div class="col-lg-12">
	 			<div class="ibox">
	 				<div class="ibox-title">
	 					<h5>업데이트</h5>
	 					<c:if test="${sessionScope.userInfoSession != null}">
	 						<button class="btn btn-default btn-xs" id="updateGo">바로가기</button>
	 					</c:if>
	 				</div>
	 				<c:forEach items="${update}" var="UpdateDTO">
	 					<div class="ibox-content">
	 						${UpdateDTO.article_title}
	 					</div>
	 				</c:forEach>
	 			</div>
	 		</div>
	 	</div>
	 	</div>
		<%@ include file="../template/footer.jsp"%>
	 </div>
	  <%@ include file="../template/chatBox.jsp"%>
	  <%-- <%@ include file="../template/right_column.jsp"%> --%>
	</div>
	<script>
        $(document).ready(function() {
        	/*var userSessionid = '${sessionScope.userInfoSession.usr_name}';
        	alert(userSessionid);
        	var form_data = {
        			userSessionid : userSessionid
        		};
        	$.ajax({
				method : "post",
				dataType : "json",
				url : "alreadySessionCheckProcess.do",
				data : form_data,
				success : function(data){
					if(data == 1){
						alert("접속");
					}else{
						
					}
				},
				error : function(request, status, error){
					swal({
						text: "로그인을 다시 해주세요",
						icon: "warning",
						confirm : "OK",
					}).then((willDelete) => {
						location.href = "userLogin.do"
					});
				}
			});*/
        	
        	var loginCheck = ${loginWellcome};
        	if(loginCheck == 1){
        		setTimeout(function() {
                    toastr.options = {
                        closeButton: true,
                        progressBar: true,
                        showMethod: 'slideDown',
                        timeOut: 800
                    };
                    toastr.success('방문을 환영합니다.', '${sessionScope.userInfoSession.usr_name} 님');
                }, 1300);
        	}
        	
        	$('#noticeGo').on("click", function(){
    			$.ajax({
    				success : function(){
    					location.href = "noticeBoardMain.do";
    				},
    				error : function(request, status, error){
    					if('${sessionScope.userInfoSession == null}'){
    						swal({
    							text: "세션이 만료되었습니다.",
    							icon: "warning",
    							confirm : "OK",
    						}).then((willDelete) => {
    							location.href = "userLogin.do"
    						});
    					}else{
    						swal({
    							title : "오류가 발생하였습니다",
    							text: "오류 코드 39",
    						  	icon: "warning",
    						})
    					}
    				}
    			});
    		});
        	
        	$('#eventGo').on("click", function(){
    			$.ajax({
    				success : function(){
    					location.href = "eventBoardMain.do";
    				},
    				error : function(request, status, error){
    					if('${sessionScope.userInfoSession == null}'){
    						swal({
    							text: "세션이 만료되었습니다.",
    							icon: "warning",
    							confirm : "OK",
    						}).then((willDelete) => {
    							location.href = "userLogin.do"
    						});
    					}else{
    						swal({
    							title : "오류가 발생하였습니다",
    							text: "오류 코드 40",
    						  	icon: "warning",
    						})
    					}
    				}
    			});
    		});
        	
        	$('#updateGo').on("click", function(){
    			$.ajax({
    				success : function(){
    					location.href = "updateBoardMain.do";
    				},
    				error : function(request, status, error){
    					if('${sessionScope.userInfoSession == null}'){
    						swal({
    							text: "세션이 만료되었습니다.",
    							icon: "warning",
    							confirm : "OK",
    						}).then((willDelete) => {
    							location.href = "userLogin.do"
    						});
    					}else{
    						swal({
    							title : "오류가 발생하였습니다",
    							text: "오류 코드 41",
    						  	icon: "warning",
    						})
    					}
    				}
    			});
    		});
    		
        });
    </script>
	<%@ include file="../template/plugin_js.jsp"%>
</body>
</html>