<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="userShop">

	<select id="itemAllList" resultType="dto.UserShopDTO">
		SELECT shop_id, shop_type, shop_element, card_room, usr_name, levels, gender, card_price,
			   card_type, DATEDIFF(card_gf, NOW()) AS itm_trans_gf, card_level, card_skill, itm_id, itm_uuid, first_owner,
			   channelPort, sale_date, return_item
		FROM cardshop
		WHERE return_item != 1 ORDER BY shop_id DESC
		LIMIT #{startRow}, #{blockCount}
	</select>
	
	<select id="itemAllListCount" resultType="int">
		SELECT count(*)
		FROM cardshop
		WHERE return_item != 1
	</select>
	
	<select id="detailinfo" resultType="dto.UserShopDTO">
		SELECT shop_id, shop_type, shop_element, card_room, usr_name, levels, gender, card_price,
			   card_type, DATEDIFF(card_gf, NOW()) AS itm_trans_gf, card_level, card_skill, itm_id, itm_uuid, first_owner,
			   channelPort, sale_date, return_item
		FROM cardshop
		WHERE shop_id = #{shop_id}
	</select>
	
	<select id="searchList" parameterType="java.util.HashMap" resultType="dto.UserShopDTO">
		SELECT shop_id, shop_type, shop_element, card_room, usr_name, levels, gender, card_price,
			   card_type, DATEDIFF(card_gf, NOW()) AS itm_trans_gf, card_level, card_skill, itm_id, itm_uuid, first_owner,
			   channelPort, sale_date, return_item
		FROM cardshop
		WHERE
		<choose>
			<when test="shop_type != -1">
				shop_type = #{shop_type} AND
			</when>
		</choose>
		<choose>
			<when test="shop_element != -1">
				shop_element = #{shop_element} AND
			</when>
		</choose>
		<choose>
			<when test="card_level != -1">
				card_level = #{card_level} AND
			</when>
		</choose>
		return_item != 1 ORDER BY shop_id DESC
		LIMIT #{startRow}, #{blockCount}
	</select>
	
	<select id="SearchCount" parameterType="java.util.HashMap" resultType="int">
		SELECT count(*)
		FROM cardshop
		WHERE
		<choose>
			<when test="shop_type != -1">
				shop_type = #{shop_type} AND
			</when>
		</choose>
		<choose>
			<when test="shop_element != -1">
				shop_element = #{shop_element} AND
			</when>
		</choose>
		<choose>
			<when test="card_level != -1">
				card_level = #{card_level} AND
			</when>
		</choose>
		return_item != 1 ORDER BY shop_id DESC
	</select>
	 
	<select id="buyShopCheck" resultType="int">
		SELECT count(*) FROM cardshop WHERE shop_id = #{shop_id}
	</select>
	
	<select id="buyUserCheck" resultType="int">
		SELECT count(*) FROM users WHERE usr_id = #{usr_id}
	</select>
	
	<select id="buyUserInfo" resultType="dto.UserDTO">
		SELECT usr_id, kakao_id, usr_name, usr_pw ,usr_ip, usr_gender, usr_char, usr_points,
		usr_level, usr_code, usr_coins, usr_cash, usr_water,usr_fire,usr_earth,usr_wind,usr_nslots
		usr_wins,usr_losses,usr_ko,usr_down,usr_scroll1, usr_scroll2, usr_scroll3,usr_mission, usr_admin,
		usr_type, usr_hwid, usr_bonus, time,usr_last_login,usr_guildname, usr_guildduty, usr_supporters,
		bandate, banstate, chatBan ,create_date FROM users WHERE usr_id = #{usr_id} 
	</select>
	
	<update id="buyUserCodeUpdate">
		UPDATE users SET usr_code = #{buyUserBalance} WHERE usr_id = #{usr_id} 
	</update>
	
	<update id="sellUserbankUpdate">
		UPDATE cardshopbank SET deposit = #{sellUserBalance} WHERE usr_name = #{sell_usr_name} 
	</update>
	
	<select id="bankCheck" resultType="int">
		SELECT count(*) FROM cardshopbank WHERE usr_name = #{usr_name} 
	</select>
	
	<insert id="sellUserbankInsert">
		INSERT INTO cardshopbank
		(usr_id, usr_name, deposit)
		VALUES
		(#{sell_usr_id}, #{sell_usr_name}, #{sellUserBalance})
	</insert>
	
	<update id="buyCardTransUpdate">
		UPDATE cardshoptrans SET itm_usr_id = #{usr_id}, itm_slot= #{emptySlot} WHERE itm_id = #{itm_id} 
	</update>
	
	<insert id="buyUserCardInsert">
		INSERT INTO items (itm_id, itm_slot, itm_usr_id, itm_type, itm_gf, itm_level, itm_skill, itm_uuid, first_owner, balance_cash, create_date) SELECT itm_id, itm_slot, itm_usr_id, itm_type, itm_gf, itm_level, itm_skill, itm_uuid, first_owner, balance_cash, create_date FROM cardshoptrans WHERE itm_id = #{itm_id}
	</insert>
	
	<delete id="sellCardShopDelete">
		DELETE FROM cardshop WHERE shop_id = #{shop_id}
	</delete>
	
	<delete id="buyCardTransDelete">
		DELETE FROM cardshoptrans WHERE itm_id = #{itm_id}
	</delete>
	
	<select id="buyUserNSlot" resultType="int">
		SELECT usr_nslots FROM users WHERE usr_id = #{usr_id} 
	</select>
	
	<select id="buyUserTotalCardCount" resultType="int">
		SELECT count(*) FROM items WHERE itm_usr_id = #{itm_usr_id} 
	</select>
	
	<select id="buyUserCardList" resultType="dto.UserCardDTO">
		SELECT itm_id, itm_slot, itm_usr_id, itm_type, DATEDIFF(itm_gf, NOW()) AS itm_trans_gf, itm_level, itm_skill
		FROM items
		WHERE itm_usr_id = #{itm_usr_id} ORDER BY itm_slot asc
	</select>
	
	<select id="sellUserInfo" resultType="dto.UserDTO">
		SELECT usr_id, kakao_id, usr_name, usr_pw ,usr_ip, usr_gender, usr_char, usr_points,
		usr_level, usr_code, usr_coins, usr_cash, usr_water,usr_fire,usr_earth,usr_wind,usr_nslots
		usr_wins,usr_losses,usr_ko,usr_down,usr_scroll1, usr_scroll2, usr_scroll3,usr_mission, usr_admin,
		usr_type, usr_hwid, usr_bonus, time,usr_last_login,usr_guildname, usr_guildduty, usr_supporters,
		bandate, banstate, chatBan ,create_date
		FROM users
		WHERE usr_name = #{usr_name}
	</select>
	
	<update id="sellUserSpiritUpdate">
		UPDATE users set 
		<choose>
			<when test="spiritType == 1">
				usr_water
			</when>
			<when test="spiritType == 2">
				usr_fire
			</when>
			<when test="spiritType == 3">
				usr_earth
			</when>
			<when test="spiritType == 4">
				usr_wind
			</when>
		</choose>
		= #{spirit} WHERE usr_id = #{sell_usr_id}
	</update>
	
	<update id="buyUserSpiritUpdate">
		UPDATE users set 
		<choose>
			<when test="spiritType == 1">
				usr_water
			</when>
			<when test="spiritType == 2">
				usr_fire
			</when>
			<when test="spiritType == 3">
				usr_earth
			</when>
			<when test="spiritType == 4">
				usr_wind
			</when>
		</choose>
		= #{spirit} WHERE usr_id = #{usr_id}
	</update>
	
	<update id="userShopLogUpdate">
		UPDATE cardshop_log SET state = #{successState}, buyer = #{buy_usr_name}, update_date =  CURRENT_TIMESTAMP WHERE itm_usr_id = #{sell_usr_id} AND itm_id = #{itm_id} AND state = #{nowState}
	</update>
	
	<select id="getBankInfo" resultType="dto.BankDTO">
		SELECT cb_id, usr_id, usr_name, deposit, update_date FROM cardshopbank WHERE usr_id = #{usr_id}
	</select>
	
	<select id="gameActiveState" resultType="dto.UserGameActiveDTO">
		SELECT usr_name, usr_ip, connect_time, channelPort, room, connect_type FROM active_list WHERE usr_name = #{usr_name}
	</select>
	
	<insert id="sendGiftMessage">
		INSERT INTO itemreceive (seller, buyer, gift_type, amount_slot, type_name, sent)
		VALUES (#{seller_name}, #{buyer_name}, #{gift_type}, #{amount_slot}, #{type_name}, #{sent})
	</insert>
	
	<insert id="sendBuyMessage">
		INSERT INTO itembuylist (seller, buyer, gift_type, amount_slot, type_name, sent)
		VALUES (#{seller_name}, #{buyer_name}, #{gift_type}, #{amount_slot}, #{type_name}, #{sent})
	</insert>
	
</mapper>