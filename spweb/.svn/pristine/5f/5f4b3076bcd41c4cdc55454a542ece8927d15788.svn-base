package dto;

public class UserRegisterDTO {

	private String usr_name;
	private String usr_pw;
	private String usr_ip;
	private int kakao_id;
	private int usr_gender;
	private int registerFlag;
	
	public UserRegisterDTO() {

	}

	public String getUsr_name() {
		return usr_name;
	}

	public void setUsr_name(String usr_name) {
		this.usr_name = usr_name;
	}

	public String getUsr_pw() {
		return usr_pw;
	}

	public void setUsr_pw(String usr_pw) {
		this.usr_pw = usr_pw;
	}

	public int getKakao_id() {
		return kakao_id;
	}

	public void setKakao_id(int kakao_id) {
		this.kakao_id = kakao_id;
	}

	public int getUsr_gender() {
		return usr_gender;
	}

	public void setUsr_gender(int usr_gender) {
		this.usr_gender = usr_gender;
	}

	public String getUsr_ip() {
		return usr_ip;
	}

	public void setUsr_ip(String usr_ip) {
		this.usr_ip = usr_ip;
	}

	public int getRegisterFlag() {
		return registerFlag;
	}

	public void setRegisterFlag(int registerFlag) {
		this.registerFlag = registerFlag;
	}
	
	
}
