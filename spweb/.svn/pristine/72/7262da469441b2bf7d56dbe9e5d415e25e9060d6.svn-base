package dto;

public class UserEquipmentsDTO {

	private int usr_id;
	private int eqp_mag;
	private int eqp_wpn;
	private int eqp_arm;
	private int eqp_pet;
	private int eqp_foot;
	private int eqp_body;
	private int eqp_hand1;
	private int eqp_hand2;
	private int eqp_face;
	private int eqp_hair;
	private int eqp_head;
	
	public UserEquipmentsDTO() {
		
	}

	
	public int getUsr_id() {
		return usr_id;
	}


	public void setUsr_id(int usr_id) {
		this.usr_id = usr_id;
	}


	public int getEqp_mag() {
		return eqp_mag;
	}

	public void setEqp_mag(int eqp_mag) {
		this.eqp_mag = eqp_mag;
	}

	public int getEqp_wpn() {
		return eqp_wpn;
	}

	public void setEqp_wpn(int eqp_wpn) {
		this.eqp_wpn = eqp_wpn;
	}

	public int getEqp_arm() {
		return eqp_arm;
	}

	public void setEqp_arm(int eqp_arm) {
		this.eqp_arm = eqp_arm;
	}

	public int getEqp_pet() {
		return eqp_pet;
	}

	public void setEqp_pet(int eqp_pet) {
		this.eqp_pet = eqp_pet;
	}

	public int getEqp_foot() {
		return eqp_foot;
	}

	public void setEqp_foot(int eqp_foot) {
		this.eqp_foot = eqp_foot;
	}

	public int getEqp_body() {
		return eqp_body;
	}

	public void setEqp_body(int eqp_body) {
		this.eqp_body = eqp_body;
	}

	public int getEqp_hand1() {
		return eqp_hand1;
	}

	public void setEqp_hand1(int eqp_hand1) {
		this.eqp_hand1 = eqp_hand1;
	}

	public int getEqp_hand2() {
		return eqp_hand2;
	}

	public void setEqp_hand2(int eqp_hand2) {
		this.eqp_hand2 = eqp_hand2;
	}

	public int getEqp_face() {
		return eqp_face;
	}

	public void setEqp_face(int eqp_face) {
		this.eqp_face = eqp_face;
	}

	public int getEqp_hair() {
		return eqp_hair;
	}

	public void setEqp_hair(int eqp_hair) {
		this.eqp_hair = eqp_hair;
	}

	public int getEqp_head() {
		return eqp_head;
	}

	public void setEqp_head(int eqp_head) {
		this.eqp_head = eqp_head;
	}
	
}
