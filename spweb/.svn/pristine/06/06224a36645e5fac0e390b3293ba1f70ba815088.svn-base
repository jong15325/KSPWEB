<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="main">


	<select id="main_user_info" resultType="dto.UserDTO">
		SELECT usr_id, usr_name, usr_pw, usr_level, usr_points from users order by usr_id asc
	</select>
	
		
	<select id="noticeBoardTotalcount" resultType="int">
		SELECT count(*) FROM
		z_article WHERE article_del = 0 AND article_category = 1
	</select>
	
	<select id="eventBoardTotalcount" resultType="int">
		SELECT count(*) FROM
		z_article WHERE article_del = 0 AND article_category = 2
	</select>
	
	<select id="updateBoardTotalcount" resultType="int">
		SELECT count(*) FROM
		z_article WHERE article_del = 0 AND article_category = 3
	</select>

		
	<select id="noticeBoardList" resultType="dto.BoardDTO">
	<![CDATA[
	SELECT article_no,
		article_title, article_content, article_writer,
		article_regdate,
		article_viewcnt
		FROM z_article
		WHERE article_category = 1 AND article_del = 0 ORDER BY article_no DESC
		LIMIT 3
	]]>
	</select>
	
	
	<select id="eventBoardList" resultType="dto.BoardDTO">
	<![CDATA[
	SELECT article_no,
		article_title, article_content, article_writer,
		article_regdate,
		article_viewcnt
		FROM z_article
		WHERE article_category = 2 AND article_del = 0 ORDER BY article_no DESC
		LIMIT 3
	]]>
	</select>

	
	<select id="updateBoardList" resultType="dto.BoardDTO">
	<![CDATA[
	SELECT article_no,
		article_title, article_content, article_writer,
		article_regdate,
		article_viewcnt
		FROM z_article
		WHERE article_category = 3 AND article_del = 0 ORDER BY article_no DESC
		LIMIT 3
	]]>
	</select>
	
	<select id="guildTopRank" resultType="dto.GuildRankDTO">
		SELECT GP.guild_name, SUM(GP.point) AS point, G.guild_leader
		FROM guildpoint AS GP JOIN guild AS G
		ON GP.guild_id = G.guild_id
		GROUP BY GP.guild_id ORDER BY SUM(GP.point) DESC LIMIT 5
	</select>
	
	<select id="userTopRank" resultType="dto.UserRankDTO">
	<![CDATA[
		SELECT usr_id, usr_name, usr_points, usr_char, usr_level FROM users WHERE usr_admin < 7 ORDER BY usr_points DESC LIMIT 5
	]]>
	</select>
	
	<select id="mainUserInfo" parameterType="String" resultType="dto.UserDTO">
		SELECT usr_id, kakao_id, usr_name, usr_pw ,usr_ip, usr_gender, usr_char, usr_points,
		usr_level, usr_code, usr_coins, usr_cash, usr_water,usr_fire,usr_earth,usr_wind,usr_nslots
		usr_wins,usr_losses,usr_ko,usr_down,usr_scroll1, usr_scroll2, usr_scroll3,usr_mission, usr_admin,
		usr_type, usr_hwid, usr_bonus, time,usr_last_login,usr_guildname, usr_guildduty, usr_supporters,
		bandate, banstate, chatBan ,create_date
		FROM users
		WHERE
		usr_name = #{usr_name}
	</select>


</mapper>