		return mav;
	}
	
	@RequestMapping(value = "/oauth.do", produces = "application/json", method = {RequestMethod.GET, RequestMethod.POST})
	public String userKakaoLogin(@RequestParam("code") String code, HttpSession session) {
		
		//System.out.println("1 : " + serverProperties.getProperty("server.ip"));
		System.out.println("2 : " + serverProperties2);
		//System.out.println("3 : " + serverProperties3.getProperty("server.ip"));
		System.out.println("카카오 인증  접근.");
		System.out.println("kakaoCode = " + code);
		// 1042695122 //똑같
		// 1043218241 //1043218241
		JsonNode node = Kakao_restTokenApi.getKakaoAccessToken(code, serverProperties.getProperty("server.ip"));

		System.out.println("Node = " + node);

		JsonNode accessToken = node.get("access_token");

		session.setAttribute("access_token", accessToken);

		JsonNode userInfo = Kakao_UserInfo.getKakaoUserInfo(accessToken);

		String id = userInfo.path("id").asText();
		String usr_name = null;
		String usr_email = null;
		
		
		JsonNode properties = userInfo.path("properties");
		JsonNode kakao_account = userInfo.path("kakao_account");
		
		usr_name = properties.path("nickname").asText();
		usr_email = kakao_account.path("email").asText();
		
		System.out.println("kakao_id : " + id);
		System.out.println("kakao_nickname : " + usr_name);
		System.out.println("kakao_email : " + usr_email);
		
		int transKakaoId = Integer.parseInt(id);
		int checkKakao = service.kakaoCountCheckService(transKakaoId);
		System.out.println("checkKakao : " + checkKakao);
		if (checkKakao < 50) { // 등록된 카카오 아이디가
			UserRegisterDTO userRegisterDto = new UserRegisterDTO();
			userRegisterDto.setKakao_id(transKakaoId);
			session.setAttribute("kakao", userRegisterDto);
			return "redirect:/userRegister.do";
		}
		
		return "redirect:/userRegisterFail.do";

	}

	// https://kauth.kakao.com/oauth/authorize?client_id=54956a942e84cb336582d1eb95702d4b&redirect_uri=http://121.141.136.218:8070/sp/oauth.do&response_type=code

}
